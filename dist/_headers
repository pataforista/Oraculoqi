# Caching policy for PWA Service Worker - Never Cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Caching policy for Web Manifest - Never Cache
/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# Caching policy for Sitemap - Never Cache & Set Correct Content-Type
/sitemap.xml
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/xml; charset=utf-8

# Caching policy for Robots - Never Cache
/robots.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

# Caching policy for compiled static assets - Cache Forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable
